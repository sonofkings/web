{
  "name": "web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/checkout",
      "/checkout/*"
    ]
  },
  "build": {
    "command": "npm test"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INVENTORY",
        "class_name": "Inventory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "inventory-v1",
      "new_sqlite_classes": [
        "Inventory"
      ]
    }
  ]
}
